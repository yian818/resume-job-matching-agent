# === ResumeMatch AI 环境变量示例 ===
# 复制为 .env 后填写：cp .env.example .env

# LLM 服务配置（DeepSeek）
OPENAI_BASE_URL=https://nb.deepsb.com/v1
MODEL_NAME=deepseek-chat

# 你的 API Key（必填）
OPENAI_API_KEY=

# API 鉴权 Token（可选）：配置后前端需填 "Bearer <此值>" 才能调用 /api/v1/*
# 留空 = 本地开发不鉴权
API_TOKEN=

# P13 稳定性（可选）
# LLM 温度：0.1 = 默认；0 = 打分波动明显减小，但实测不能消除近分岗位的 Top-1 翻转（见 PROJECT_LOG P13）
LLM_TEMPERATURE=0.1
# LLM 打分集成次数：1 = 关闭（默认）；3 = 每次打分跑3次取中位数（降波动，3倍成本，但不消除翻转）
SCORE_RUNS=1